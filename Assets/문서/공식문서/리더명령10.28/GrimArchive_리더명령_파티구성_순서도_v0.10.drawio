Cell><mxCell id="L08_effect" value="기존 공격 대상 유지&#10;오우거에게 사용할&#10;공격 기술을 우선 선택" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#EDE6F2;strokeColor=#675A70;strokeWidth=2;fontColor=#211A27;fontSize=28;fontFamily=Noto Sans CJK KR;" vertex="1" parent="1"><mxGeometry x="870" y="1030" width="350" height="170" as="geometry"/></mxCell><mxCell id="L08_none" value="강공격 명령 없이&#10;기존 개인 행동 계속" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#FAF8FC;strokeColor=#675A70;strokeWidth=2;fontColor=#211A27;fontSize=28;fontFamily=Noto Sans CJK KR;" vertex="1" parent="1"><mxGeometry x="150" y="1300" width="560" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="L09" name="L09 보호 사용 예시"><mxGraphModel dx="1200" dy="1190" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1190"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="L09_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#675A70;strokeWidth=2;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="L09_start" target="L09_danger"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L09_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#675A70;strokeWidth=2;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="L09_danger" target="L09_skill"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L09_label1" value="예" style="text;html=0;strokeColor=none;fillColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=24;fontFamily=Noto Sans CJK KR;fontColor=#675A70;" vertex="1" parent="1"><mxGeometry x="570" y="482" width="130" height="36" as="geometry"/></mxCell><mxCell id="L09_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeC