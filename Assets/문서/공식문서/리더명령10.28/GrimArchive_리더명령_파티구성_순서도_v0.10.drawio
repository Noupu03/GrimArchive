html=0;endArrow=block;endFill=1;strokeColor=#675A70;strokeWidth=2;fontSize=20;fontFamily=Noto Sans CJK KR;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;exitPerimeter=1;entryX=0.5;entryY=0.0;entryPerimeter=1;" edge="1" parent="1" source="L02_f" target="L02_g"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="660" as="sourcePoint"/><mxPoint x="550" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="L02_a" value="설정 명령·현재 통솔력·전달 조건 확인" style="rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#FAF8FC;strokeColor=#675A70;fontColor=#211A27;fontFamily=Noto Sans CJK KR;fontSize=23;spacing=8;" vertex="1" parent="1"><mxGeometry x="295" y="15" width="510" height="58" as="geometry"/></mxCell><mxCell id="L02_b" value="발령 조건을 충족한&#10;전술 명령이 있는가" style="rhombus;whiteSpace=wrap;html=0;fillColor=#EDE6F2;strokeColor=#675A70;fontColor=#211A27;fontFamily=Noto Sans CJK KR;fontSize=23;spacing=8;" vertex="1" parent="1"><mxGeometry x="370" y="110" width="360" height="130" as="geometry"/></mxCell><mxCell id="L02_conditions" value="명령별 조건&#10;집중: 시야·신규 1.5배·교체 1.2배&#10;강공격: 새 교전·집중 변경&#10;행동 불능·해금한 HP 30% 이하&#10;제압: 근접 교전·후위 위협&#10;보호: 저체력·위협 / 행동 불능·피격&#10;행동 우선 3종 공통&#10;통솔력 40·현재 수행자 1명 이상&#10;후위 위협 제압은 CC 수행자 필요&#10;상위: 다수 파티 / 고유: 스킬 조건" style="rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#FAF8FC;strokeColor=#675A70;fontColor=#211A27;fontFamily=Noto Sans CJK KR;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry x="15" y="100" width="320" height="320" as="geometry"/></mxCell><mxCell id="L02_c" value="리더 명령의 쿨타임과 필요한&#10;개별 쿨타임이 끝났는가" style="rhombus;whiteSpace=wrap;html=0;fillColor=#EDE6F2;strokeColor=#675A70;fontColor=#211A27;fontFamily=Noto Sans CJK KR;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="375" y="290" width="350" height="125" as="geometry"/></mxCell><mxCell id="L02_e" value="새 전술 명령 없음&#10;개인 전투와 기존 명령 계속" style="rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#FAF8FC;strokeColor=#675A70;fontColor=#211A27;fontFamily=Noto Sans CJK KR;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="795" y="290" width="290" height="105" as="geometry"/></mxCell><mxCell id="L02_priority" value="가능한 전술 명령 한 종류 선택&#10;고유 → 상위 공동 공격 → 집중 공격&#10;→ 강공격·제압·보호 명령군&#10;명령군 안에서는 파티 컨셉별 순서 적용" style="rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#FAF8FC;strokeColor=#675A70;fontColor=#211A27;fontFamily=Noto Sans CJK KR;fontSize=19;spacing=8;" vertex="1" parent="1"><mxGeometry x="265" y="470" width="570" height="115" as="geometry"/></mxCell><mxCell id="L02_f" value="명령·리더 명령의 쿨타임 시작&#10;일반 10초 / 상위 15초" style="rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#FAF8FC;strokeColor=#675A70;fontColor=#211A27;fontFamily=Noto Sans CJK KR;fontSize=19;spacing=8;" vertex="1" parent="1"><mxGeometry x="300" y="600" width="500" height="60" as="geometry"/></mxCell><mxCell id="L02_g" value="강공격·제압·보호 기술 우선: 5초&#10;파티원은 명령을 받은 때·리더는 명령한 때부터&#10;집중 공격 지정 유지 / 사용 불가 시 개인 행동" style="rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#FAF8FC;strokeColor=#675A70;fontColor=#211A27;fontFamily=Noto Sans CJK KR;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="160" y="700" width="780" height="110" as="geometry"/></mxCell><mxCell id="L02_note" value="후퇴·집결·문 개방·파괴·방 이동에는 리더 명령의 쿨타임을 적용하지 않는다." style="rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#FAF8FC;strokeColor=#675A70;fontColor=#211A27;fontFamily=Noto Sans CJK KR;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="100" y="840" width="900" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="L03" name="L03 집중 공격 신규 지정과 교체"><mxGraphModel dx="1200" dy="810" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="810"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="L03_start" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#675A70;strokeWidth=2;fontSize=20;fontFami