 parent="1"><mxGeometry x="390" y="12" width="300" height="48" as="geometry"/></mxCell><mxCell id="L01_b" value="사망한 리더의 명령·기본 버프 종료" style="rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#FAF8FC;strokeColor=#675A70;fontColor=#211A27;fontFamily=Noto Sans CJK KR;fontSize=22;spacing=8;" vertex="1" parent="1"><mxGeometry x="300" y="95" width="480" height="64" as="geometry"/></mxCell><mxCell id="L01_wait" value="사망 시점부터 10초간 개인 행동&#10;파티 소속·기존 임무 유지" style="rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#FAF8FC;strokeColor=#675A70;fontColor=#211A27;fontFamily=Noto Sans CJK KR;fontSize=22;spacing=8;" vertex="1" parent="1"><mxGeometry x="300" y="194" width="480" height="78" as="geometry"/></mxCell><mxCell id="L01_c" value="10초 후 생존하며&#10;리더 자격을 충족한&#10;후임이 있는가" style="rhombus;whiteSpace=wrap;html=0;fillColor=#EDE6F2;strokeColor=#675A70;fontColor=#211A27;fontFamily=Noto Sans CJK KR;fontSize=19;spacing=8;" vertex="1" parent="1"><mxGeometry x="350" y="292" width="380" height="150" as="geometry"/></mxCell><mxCell id="L01_d" value="일반 리더 후임 승계&#10;현재 상황으로 새 명령 판단" style="rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#FAF8FC;strokeColor=#675A70;fontColor=#211A27;fontFamily=Noto Sans CJK KR;fontSize=22;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="462" width="400" height="72" as="geometry"/></mxCell><mxCell id="L01_e" value="후임 없음&#10;소속·임무를 유지하며 각자 행동" style="rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#FAF8FC;strokeColor=#675A70;fontColor=#211A27;fontFamily=Noto Sans CJK KR;fontSize=22;spacing=8;" vertex="1" parent="1"><mxGeometry x="620" y="462" width="400" height="72" as="geometry"/></mxCell><mxCell id="L01_f" value="새 명령·유효 기본 버프 적용" style="rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#FAF8FC;strokeColor=#675A70;fontColor=#211A27;fontFamily=Noto Sans CJK KR;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="576" width="400" height="62" as="geometry"/></mxCell><mxCell id="L01_g" value="개인 행동·개인 후퇴 조건 적용" style="rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#FAF8FC;strokeColor=#675A70;fontColor=#211A27;fontFamily=Noto Sans CJK KR;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="620" y="576" width="400" height="62" as="geometry"/></mxCell><mxCell id="L01_note" value="사망 충격 10초는 각 파티원의 사망 인지 시점부터 계산한다.&#10;살아 있는 상위 지휘관의 유효 명령은 유지한다. 상위 지휘관 직책은 자동 승계하지 않는다." style="rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#FAF8FC;strokeColor=#675A70;fontColor=#211A27;fontFamily=Noto Sans CJK KR;fontSize=17;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="655" width="1040" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="L02" name="L02 전투 명령 조건과 수행"><mxGraphModel dx="1100" dy="910" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="910"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="L02_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#675A70;strokeWidth=2;fontSize=20;fontFamily=Noto Sans CJK KR;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;exitPerimeter=1;entryX=0.5;entryY=0.0;entryPerimeter=1;" edge="1" parent="1" source="L02_a" target="L02_b"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="73" as="sourcePoint"/><mxPoint x="550" y="110" as="targetPoint"/></mxGeometry></mxCell><mxCell id="L02_e1" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#675A70;strokeWidth=2;fontSize=20;fontFamily=Noto Sans CJK KR;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;exitPerimeter=1;entryX=0.5;entryY=0.0;entryPerimeter=1;" edge="1" parent="1" source="L02_b" target="L02_c"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="240" as="sourcePoint"/><mxPoint x="550" y="290" as="targetPoint"/></mxGeometry></mxCell><mxCell id="L02_e2" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFil